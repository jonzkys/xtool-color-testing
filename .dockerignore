# Keep the build context small — only what the Dockerfile COPYs.
.git
.github
.venv
venv
__pycache__
*.pyc
*.pyo
*.egg-info
*.swp
.pytest_cache
.mypy_cache
.ruff_cache
.idea
.vscode

# Frontend source + build artefacts — not bundled into the API image.
web/node_modules
web/dist

# Docs, samples, local scratch.
docs
samples
output
debug
README.md
LICENSE

# Local dev databases and secrets.
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Test artefacts.
tests
.coverage
htmlcov

# Editor droppings.
.DS_Store
